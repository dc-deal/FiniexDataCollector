# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Host path of the shared inter-project conversation bus, mounted at /bus. Empty here on
# purpose: a fresh clone has no sibling exchange folder, and the compose default then mounts
# a tracked empty stub instead. On a machine that participates, set it to the folder's path
# relative to this file, e.g. ../FiniexInterprojectExchangeFolder
FINIEX_BUS_PATH=
