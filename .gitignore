MANIFEST

# Start scripts live on the machine they start, never here. They are the kind of
# file that grows a credential - the RAG engine's carries four - and a tracked
# copy both invites that and drifts from the one actually in use.
start_*.ps1
*_env.ps1

# Virtual Environment
venv/
.venv/
ENV/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Jupyter Notebook
.ipynb_checkpoints

# pytest
.pytest_cache/
.coverage
htmlcov/

# User configs (overrides including secrets)
user_configs/*.json
!user_configs/*.example.json
!user_configs/.gitkeep

# Broker configs (except examples)
configs/brokers/*/*.json
!configs/brokers/*/*.example.json

# Data
data/
*.parquet
*.csv

# Logs
logs/
*.log

# OS
.DS_Store
Thumbs.db

# Internal working docs (private — may reference user_algos / private bots)
INTERNAL_*.md
ISSUE_*.md
HANDOFF_*.md


# GitHub issues export (local reference only)
github_issues/
export_github_issues.sh

# Local environment — the tracked counterpart is .env.example
.env

# Local MCP server registration; carries the peer name this checkout writes the bus as.
# .mcp.json.example is the tracked counterpart, like .env.example and user_configs/.
.mcp.json
